// ==========================================
// DRAW LOGO
// ==========================================

draw_set_alpha(logo_alpha);

draw_sprite_ext(
    sStudioLogo,
    0,
    420,
    50,
    2,
    2,
    0,
    c_white,
    1
);


// ==========================================
// RESET
// ==========================================

draw_set_alpha(1);


// ==========================================
// BLACK FADE OVERLAY
// ==========================================

draw_set_alpha(fade_alpha);

draw_set_color(c_black);

draw_rectangle(
    0,
    0,
    1920,
    1080,
    false
);


// ==========================================
// RESET
// ==========================================

draw_set_alpha(1);
draw_set_color(c_white);